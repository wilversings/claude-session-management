{
  "name": "claude-session-management",
  "version": "1.0.0",
  "description": "Pin (star), move, and delete Claude Code sessions from the command line.",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "sessions",
    "resume"
  ],
  "homepage": "https://github.com/wilversings/claude-session-management#readme",
  "bugs": {
    "url": "https://github.com/wilversings/claude-session-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilversings/claude-session-management.git"
  },
  "license": "MIT",
  "author": "Marius Aiordăchioaei <aiordachioaei.marius@gmail.com>",
  "type": "commonjs",
  "bin": {
    "claude-session": "dist/claude-session.js"
  },
  "man": "./man/claude-session.1",
  "files": [
    "claude-sessions.js",
    "lib/",
    "commands/",
    "man/",
    "dist/"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "test": "for f in claude-sessions.js lib/*.js commands/*.js; do node --check \"$f\" || exit 1; done && echo 'syntax OK'",
    "build": "esbuild claude-sessions.js --bundle --minify --platform=node --target=node14 --outfile=dist/claude-session.js --log-level=warning",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
